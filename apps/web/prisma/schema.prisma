generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth) ────────────────────────────────────────────────────────

enum UserStatus {
  PENDING
  APPROVED
  DENIED
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  status        UserStatus @default(PENDING)
  isAdmin       Boolean    @default(false)
  unitSystem    UnitSystem @default(METRIC)
  createdAt     DateTime   @default(now())

  accounts Account[]
  sessions Session[]
  trips    Trip[]

  diveLogs             DiveLog[]
  diveSites            DiveSite[]
  diveAreas            DiveArea[]
  diveCertifications   DiveCertification[]
  diveEquipment        DiveEquipment[]
  diveEquipmentService DiveEquipmentService[]
}

model Settings {
  id               String  @id @default("global")
  registrationOpen Boolean @default(false)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core ───────────────────────────────────────────────────────────────────

model Trip {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  coverImage  String?
  startDate   DateTime
  endDate     DateTime
  status      TripStatus @default(PLANNING)
  currency    String     @default("EUR")
  budget      Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations   Destination[]
  flights        Flight[]
  accommodations Accommodation[]
  activities     Activity[]
  documents      Document[]
  expenses       Expense[]
  packingItems   PackingItem[]
  tasks          Task[]
  diveLogs       DiveLog[]
}

enum TripStatus {
  PLANNING
  BOOKED
  ONGOING
  COMPLETED
  CANCELLED
}

model Destination {
  id            String   @id @default(cuid())
  tripId        String
  city          String
  country       String
  arrivalDate   DateTime
  departureDate DateTime
  notes         String?
  order         Int      @default(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ─── Flights ────────────────────────────────────────────────────────────────

model Flight {
  id              String      @id @default(cuid())
  tripId          String
  airline         String?
  flightNumber    String?
  origin          String
  destination     String
  originLat       Float?
  originLng       Float?
  destinationLat  Float?
  destinationLng  Float?
  departureAt     DateTime?
  arrivalAt       DateTime?
  bookingRef      String?
  confirmationUrl String?
  seatNumber      String?
  class           FlightClass @default(ECONOMY)
  price           Float?
  notes           String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum FlightClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

// ─── Accommodations ─────────────────────────────────────────────────────────

model Accommodation {
  id              String            @id @default(cuid())
  tripId          String
  name            String
  type            AccommodationType @default(HOTEL)
  address         String?
  city            String
  checkIn         DateTime?
  checkOut        DateTime?
  bookingRef      String?
  confirmationUrl String?
  price           Float?
  pricePerNight   Float?
  latitude        Float?
  longitude       Float?
  notes           String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum AccommodationType {
  HOTEL
  HOSTEL
  AIRBNB
  APARTMENT
  RESORT
  OTHER
}

// ─── Activities ─────────────────────────────────────────────────────────────

model Activity {
  id              String        @id @default(cuid())
  tripId          String
  name            String
  type            ActivityType  @default(ACTIVITY)
  description     String?
  location        String?
  city            String?
  scheduledAt     DateTime?
  duration        Int? // minutes
  bookingRef      String?
  confirmationUrl String?
  price           Float?
  status          BookingStatus @default(PENDING)
  latitude        Float?
  longitude       Float?
  notes           String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum ActivityType {
  ACTIVITY
  RESTAURANT
  MUSEUM
  TOUR
  TRANSPORT
  SHOW
  OTHER
}

enum BookingStatus {
  PENDING
  RESERVED
  CONFIRMED
  CANCELLED
}

// ─── Documents ──────────────────────────────────────────────────────────────

model Document {
  id        String       @id @default(cuid())
  tripId    String
  type      DocumentType
  name      String
  fileUrl   String?
  expiresAt DateTime?
  notes     String?
  createdAt DateTime     @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum DocumentType {
  PASSPORT
  VISA
  INSURANCE
  TICKET
  VOUCHER
  OTHER
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model Expense {
  id              String          @id @default(cuid())
  tripId          String
  category        ExpenseCategory
  description     String
  amount          Float
  currency        String          @default("EUR")
  exchangeRate    Float?
  convertedAmount Float?
  date            DateTime
  paid            Boolean         @default(false)
  notes           String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum ExpenseCategory {
  FLIGHT
  ACCOMMODATION
  FOOD
  TRANSPORT
  ACTIVITY
  SHOPPING
  OTHER
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id        String       @id @default(cuid())
  tripId    String
  title     String
  notes     String?
  dueDate   DateTime?
  priority  TaskPriority @default(MEDIUM)
  done      Boolean      @default(false)
  createdAt DateTime     @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// ─── Packing List ────────────────────────────────────────────────────────────

model PackingItem {
  id       String  @id @default(cuid())
  tripId   String
  category String
  name     String
  packed   Boolean @default(false)
  quantity Int     @default(1)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ─── Dive Log ────────────────────────────────────────────────────────────────

enum DiveSource {
  MANUAL
  IMPORTED
}

enum GasMix {
  AIR
  NITROX
  TRIMIX
  OXYGEN
}

enum DiveCurrent {
  NONE
  LIGHT
  MODERATE
  STRONG
}

enum DiveEntryType {
  SHORE
  BOAT
}

model DiveArea {
  id        String   @id @default(cuid())
  userId    String
  name      String
  country   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  diveSites DiveSite[]
}

model DiveSite {
  id         String     @id @default(cuid())
  userId     String
  diveAreaId String?
  name       String
  address    String?
  country    String?
  region     String?
  latitude   Float?
  longitude  Float?
  notes      String?
  source     DiveSource @default(MANUAL)
  externalId String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diveArea DiveArea? @relation(fields: [diveAreaId], references: [id], onDelete: SetNull)
  diveLogs DiveLog[]

  @@unique([userId, externalId])
}

model DiveLog {
  id               String     @id @default(cuid())
  userId           String
  tripId           String?
  diveSiteId       String?
  date             DateTime
  diveNumber       Int
  depthMax         Float
  bottomTime       Int
  surfaceInterval  Int?
  gasMix           GasMix
  o2Percentage     Int?
  heliumPercentage Int?
  pressureStart    Int?
  pressureEnd      Int?
  waterTemp        Float?
  airTemp          Float?
  visibility       Float?
  visibilityHorizontal Float?
  diveType         String?
  buddyName        String?
  suitType         String?
  weight           Float?
  notes            String?
  rating           Int?
  current          DiveCurrent?
  divemaster       String?
  boat             String?
  entryType        DiveEntryType?
  decoRequired     Boolean       @default(false)
  safetyStopMinutes Int?
  minPpo2          Float?
  maxPpo2          Float?
  cnsPercent       Int?
  source           DiveSource @default(MANUAL)
  externalId       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip           Trip?               @relation(fields: [tripId], references: [id], onDelete: SetNull)
  diveSite       DiveSite?           @relation(fields: [diveSiteId], references: [id], onDelete: SetNull)
  equipment      DiveEquipment[]
  profileSamples DiveProfileSample[]

  @@unique([userId, externalId])
}

model DiveProfileSample {
  id        String @id @default(cuid())
  diveLogId String
  seconds   Int
  depth     Float
  temp      Float?

  diveLog DiveLog @relation(fields: [diveLogId], references: [id], onDelete: Cascade)

  @@index([diveLogId, seconds])
}

enum EquipmentCategory {
  WETSUIT
  BCD
  REGULATOR
  COMPUTER
  FINS
  MASK
  TANK
  WEIGHT
  TORCH
  CAMERA
  OTHER
}

enum EquipmentStatus {
  OWNED
  WISHLIST
  RETIRED
  SOLD
}

model DiveEquipment {
  id                    String            @id @default(cuid())
  userId                String
  name                  String
  category              EquipmentCategory
  brand                 String?
  model                 String?
  size                  String?
  serialNumber          String?
  purchaseDate          DateTime?
  purchasePrice         Float?
  status                EquipmentStatus   @default(OWNED)
  lastServiceDate       DateTime?
  serviceIntervalMonths Int?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  diveLogs       DiveLog[]
  serviceHistory DiveEquipmentService[]
}

model DiveEquipmentService {
  id          String   @id @default(cuid())
  userId      String
  equipmentId String
  date        DateTime
  description String
  cost        Float?
  notes       String?
  createdAt   DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment DiveEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model DiveCertification {
  id             String     @id @default(cuid())
  userId         String
  agency         String
  level          String
  certNumber     String?
  issueDate      DateTime?
  instructorName String?
  notes          String?
  source         DiveSource @default(MANUAL)
  externalId     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
}
