# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tripplanner"

# NextAuth
AUTH_SECRET=""   # genera con: openssl rand -base64 32

# URL pública real del despliegue (sin trailing slash). Necesaria para que
# NextAuth detecte contexto HTTPS y emita la cookie de sesión con flag Secure.
AUTH_URL=""
# true si la app corre detrás de un reverse proxy (Traefik, nginx) con
# terminación TLS — permite a NextAuth confiar en X-Forwarded-Proto/Host.
AUTH_TRUST_HOST=""

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Resend (email magic link) - https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@tripplanner.app"

# Email del administrador — recibe notificaciones y accede a /admin
ADMIN_EMAIL=""

# Login de desarrollo local (solo NODE_ENV !== production) — deja ambas vacías
# para desactivar el formulario "Dev Login" en /auth/signin
DEV_ADMIN_EMAIL=""
DEV_ADMIN_PASSWORD=""

# Cifrado de tokens OAuth en BD (32 bytes en hex = 64 chars)
# genera con: node -e "require('crypto').randomBytes(32).toString('hex')"
TOKEN_ENCRYPTION_KEY=""

# Biblioteca de media servida por Jellyfin (issue #311)
# Admite dos formas, y la app decide por lo que encuentre en la ruta:
#   - un MANIFIESTO (fichero .json): lo genera el servidor y trae, por clip, el
#     instante ya resuelto y el ItemId leído de la base de datos de Jellyfin.
#     Es la forma de staging y producción: la app no necesita entonces ningún
#     acceso de lectura al material.
#   - un DIRECTORIO: se escanea. De cada fichero se usan el nombre y la fecha de
#     modificación —su diferencia es el huso que tenía la cámara— y el ItemId se
#     calcula, para lo cual hace falta JELLYFIN_LIBRARY_PATH. Es la forma local,
#     con la tarjeta de la cámara puesta.
# Formato del manifiesto (todas las claves obligatorias; las demás se ignoran):
#   { "version": 1,
#     "generated_at": "2026-09-17T19:05:24Z",
#     "clips": [ { "jellyfin_path": "/ruta/en/jellyfin/CLIP_0064.MP4",
#                  "jellyfin_item_id": "0000ffff0000ffff0000ffff0000ffff",
#                  "kind": "video",       // video | photo
#                  "captured_at_utc": "2026-01-25T14:13:16Z",
#                  "size_bytes": 93285139 } ] }
# jellyfin_item_id puede ser null: el fichero existe pero Jellyfin aún no lo ha
# escaneado, y la app lo lista sin enlace ni miniatura. Quien genere el
# manifiesto debe abortar sin escribir si no puede leer la base de datos de
# Jellyfin — un manifiesto entero a null se aceptaría como válido y dejaría la
# sección sin miniaturas sin ninguna señal de por qué.
MEDIA_LIBRARY_PATH=
# Solo para la forma de directorio: la misma biblioteca vista desde Jellyfin,
# para poder calcular el ItemId. Con manifiesto no hace falta.
JELLYFIN_LIBRARY_PATH=
# Se prueban en orden en el navegador: la interna resuelve en LAN/Tailscale,
# la pública desde fuera. Con ninguna definida la sección no se renderiza.
JELLYFIN_INTERNAL_URL=
JELLYFIN_PUBLIC_URL=
# Solo seed: fichero donde generar un manifiesto de prueba (staging/lab).
# Deliberadamente distinto de MEDIA_LIBRARY_PATH — el seed lo sobrescribe y esa
# otra puede apuntar a material real.
SEED_MEDIA_LIBRARY_PATH=
