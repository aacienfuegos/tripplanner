# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tripplanner"

# NextAuth
AUTH_SECRET=""   # genera con: openssl rand -base64 32

# URL pública real del despliegue (sin trailing slash). Necesaria para que
# NextAuth detecte contexto HTTPS y emita la cookie de sesión con flag Secure.
AUTH_URL=""
# true si la app corre detrás de un reverse proxy (Traefik, nginx) con
# terminación TLS — permite a NextAuth confiar en X-Forwarded-Proto/Host.
AUTH_TRUST_HOST=""

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Resend (email magic link) - https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@tripplanner.app"

# Email del administrador — recibe notificaciones y accede a /admin
ADMIN_EMAIL=""

# Login de desarrollo local (solo NODE_ENV !== production) — deja ambas vacías
# para desactivar el formulario "Dev Login" en /auth/signin
DEV_ADMIN_EMAIL=""
DEV_ADMIN_PASSWORD=""

# Cifrado de tokens OAuth en BD (32 bytes en hex = 64 chars)
# genera con: node -e "require('crypto').randomBytes(32).toString('hex')"
TOKEN_ENCRYPTION_KEY=""

# Biblioteca de media servida por Jellyfin (issue #311)
# Ruta del bind read-only DENTRO del contenedor.
# De cada fichero se usan el nombre y la FECHA DE MODIFICACIÓN: la diferencia
# entre ambos es el huso que tenía puesto la cámara. Si la biblioteca son
# ficheros vacíos, quien los genere debe copiar en esa fecha el creation_time
# del MP4 original (que DJI guarda en UTC); sin eso el emparejamiento sigue
# funcionando, pero deja de ser inmune a que el reloj de la cámara cambie a
# mitad de viaje.
MEDIA_LIBRARY_PATH=
# La misma biblioteca vista desde Jellyfin: entra en el hash del ItemId y no
# tiene por qué coincidir con el punto de montaje de este contenedor
JELLYFIN_LIBRARY_PATH=/mnt/media/buceo
# Se prueban en orden en el navegador: la interna resuelve en LAN/Tailscale,
# la pública desde fuera. Con ninguna definida la sección no se renderiza.
JELLYFIN_INTERNAL_URL=
JELLYFIN_PUBLIC_URL=
# Solo seed: directorio donde generar una biblioteca de prueba (staging/lab).
# Deliberadamente distinto de MEDIA_LIBRARY_PATH — el seed borra ficheros y esa
# otra puede apuntar a material real.
SEED_MEDIA_LIBRARY_PATH=
