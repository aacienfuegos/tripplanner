# ── Base de datos ─────────────────────────────────────────────────────────────
# Nombres POSTGRES_* — los lee postgres directamente, sin sustitución intermedia
POSTGRES_USER=tripuser
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=tripplanner
# El host es "db" (nombre del servicio en docker-compose), no localhost
DATABASE_URL="postgresql://tripuser:CAMBIA_ESTO@db:5432/tripplanner"

# ── Puerto de la app ──────────────────────────────────────────────────────────
# Puerto del host al que se expone la app (nginx-host.conf debe coincidir)
APP_PORT=3000

# ── NextAuth (OBLIGATORIO) ────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET=""
# URL pública del servidor (IP o dominio, sin trailing slash)
AUTH_URL="http://TU_IP_O_DOMINIO"

# ── OAuth (opcional) ──────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ── Email (opcional) ──────────────────────────────────────────────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@tudominio.com"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email del administrador — se auto-aprueba y obtiene acceso a /admin en el primer login
ADMIN_EMAIL=""
