{
  "name": "tripplanner",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/android",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "19.2.17",
    "find-my-way": "9.7.0",
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    },
    "@expo/metro-config": {
      "postcss": "8.5.22"
    },
    "@hono/node-server": "2.0.11",
    "xcode": {
      "uuid": "11.1.1"
    },
    "brace-expansion": "5.0.8",
    "valibot": "1.4.2"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test:web": "npm run test --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "dev:android": "npm run start --workspace=apps/android"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
