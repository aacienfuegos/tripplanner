{
  "name": "tripplanner",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/android",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "19.2.17",
    "find-my-way": "9.7.0",
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    },
    "@expo/metro-config": {
      "postcss": "8.5.22"
    },
    "@hono/node-server": "2.0.11",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test:web": "npm run test --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "dev:android": "npm run start --workspace=apps/android"
  }
