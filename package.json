{
  "name": "tripplanner",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test:web": "npm run test --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "dev:android": "npm run start --workspace=apps/android"
  }
}
