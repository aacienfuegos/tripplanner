# ── Base de datos ─────────────────────────────────────────────────────────────
# Credenciales distintas de producción (aislamiento entre entornos)
POSTGRES_USER=tripuser_staging
POSTGRES_PASSWORD=CAMBIA_ESTO_STAGING
POSTGRES_DB=tripplanner_staging
# El host es "db" (nombre del servicio en docker-compose), no localhost
DATABASE_URL="postgresql://tripuser_staging:CAMBIA_ESTO_STAGING@db:5432/tripplanner_staging"

# ── Puerto de la app ──────────────────────────────────────────────────────────
# Distinto de producción (3000) para que ambos corran en el mismo servidor
APP_PORT=3001

# ── NextAuth (OBLIGATORIO) ────────────────────────────────────────────────────
# DISTINTO del de producción — genera con: openssl rand -base64 32
# (sesiones staging y prod no son intercambiables)
AUTH_SECRET=""
# URL pública del subdominio de staging (sin trailing slash)
AUTH_URL="https://staging.TU_DOMINIO"

# ── OAuth (opcional) ──────────────────────────────────────────────────────────
# Si reutilizas las mismas apps OAuth de producción, debes añadir el callback
# de staging a los redirect URIs autorizados:
#   Google: https://console.cloud.google.com/apis/credentials
#     → Añadir: https://staging.TU_DOMINIO/api/auth/callback/google
#   GitHub: Settings → Developer settings → OAuth Apps
#     → Añadir: https://staging.TU_DOMINIO/api/auth/callback/github
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ── Email (opcional) ──────────────────────────────────────────────────────────
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@TU_DOMINIO"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email del administrador — se auto-aprueba y obtiene acceso a /admin en el primer login
ADMIN_EMAIL=""

# ── Dataset de prueba ─────────────────────────────────────────────────────────
# Si está en "true", ejecuta `prisma db seed` en cada arranque del contenedor.
# Crea el usuario dev (admin@dev.local / admin123) y 3 viajes de ejemplo.
# Útil para staging; dejar en "false" (o no definir) en producción.
SEED_DB=true
